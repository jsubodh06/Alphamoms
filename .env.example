# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_WEBHOOK_URL: Optional Google Apps Script web-app URL to mirror live RSVPs to Google Sheets.
GOOGLE_SHEETS_WEBHOOK_URL=""

# ADMIN_EMAIL: Authorized Google account email for /admin access.
ADMIN_EMAIL="subodhjain2007777@gmail.com"

# VITE_API_BASE_URL: Optional remote backend URL (e.g. Cloud Run URL) when deploying frontend-only on Vercel.
VITE_API_BASE_URL=""

# VITE_GOOGLE_SHEETS_WEBHOOK_URL: Optional client-side Google Apps Script URL for zero-backend deployments.
VITE_GOOGLE_SHEETS_WEBHOOK_URL=""

